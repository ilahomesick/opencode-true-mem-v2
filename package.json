{
  "name": "opencode-true-mem-v2",
  "version": "0.1.0",
  "description": "OpenCode V2 port of true-mem — persistent cognitive memory plugin (fork of rizal72/true-mem)",
  "main": "dist/entry.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/entry.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "bun build src/v2/entry.ts --outdir dist --target bun --format esm && bun build src/tui.ts --outdir dist --target bun --format esm && bun build src/memory/embedding-worker.ts --outdir dist/memory --target bun --format esm",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "ai",
    "memory",
    "plugin",
    "persistent",
    "cognitive",
    "coding-assistant"
  ],
  "author": "rizal72",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilahomesick/opencode-true-mem-v2.git"
  },
  "bugs": {
    "url": "https://github.com/ilahomesick/opencode-true-mem-v2/issues"
  },
  "homepage": "https://github.com/ilahomesick/opencode-true-mem-v2#readme",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "PORT-NOTES.md"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.0.0-next.1",
    "@opencode-ai/plugin": "^1.2.6",
    "@opencode-ai/sdk": "^1.2.6",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/uuid": "^10.0.0",
    "bun-types": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
